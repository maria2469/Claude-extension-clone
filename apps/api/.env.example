# Environment configuration for Malude API
ENV=development
PRODUCT_NAME=Malude

# LLM Provider — choose ONE:
# Option A: Groq (free, fast — recommended for development)
GROQ_API_KEY=your-groq-api-key-here
MODEL_AGENT=llama-3.3-70b-versatile
MODEL_FAST=llama-3.1-8b-instant

# Option B: Anthropic (higher quality, paid)
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_AGENT=claude-sonnet-4-5-20250514
# MODEL_FAST=claude-haiku-4-5-20250514

# Supabase Auth and Database (optional — leave blank for dev-secret JWT mode)
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=dev-secret
DATABASE_URL=

# Allowed Origins (CORS)
EXTENSION_ORIGINS=chrome-extension://dev-id
WEB_ORIGIN=http://localhost:3000

# Observability (optional)
SENTRY_DSN=

# Limits and safety thresholds
MAX_BODY_BYTES=5242880
STEPS_PER_MINUTE=30
REVIEWS_PER_MINUTE=10
